# Envio das cotações e mensagens de contato por e-mail (Resend: https://resend.com).
# Sem estas variáveis, o site NÃO finge que enviou: oferece WhatsApp, e-mail e copiar o pedido.
RESEND_API_KEY=
# Remetente verificado no Resend (domínio da Bacchi), ex.: "Site Bacchi <site@bacchi.ind.br>"
COTACAO_REMETENTE=
# Quem recebe as cotações e mensagens, ex.: bacchivendas@uol.com.br (separe vários com vírgula)
COTACAO_DESTINO=
# Endereço público do site, para links, sitemap e Open Graph
NEXT_PUBLIC_SITE_URL=https://clipsbacchi.com.br
