  "narrative": {
    "northStar": "The Part Line",
    "overview": "The page is a quiet, light editorial spread for one barber's chair in Campanário, Diadema. It has no colour of its own beyond warm off-white, ink and a thin champagne. All the saturation comes from Leonardo's real photographs: the red, white and blue striped capes and the dark, hard-edged fades. One gesture repeats: a 1px champagne hairline, *a risca*, drawn under headlines like the hard part line in the cuts. It draws in from the left when it enters the screen.\n\nDensity is low and deliberate. Sections breathe (96–144px vertical padding), headlines are large and set in a high-contrast display serif, and the UI text is a clean grotesk set in small, tracked capitals. Depth comes from tonal panels (white on off-white, one ink band, a sand panel), never shadows. Photographs are large, square-cornered and edge-to-edge inside their frames. The hero photo bleeds off the right edge of the viewport and dissolves into the ground on its left. The client rejected the earlier all-dark \"escala do degradê\" version; this world replaces it entirely.",
    "keyCharacteristics": [
      "Warm off-white ground with white and sand panels; one ink feature band.",
      "Real photographs carry all the saturated colour.",
      "Champagne only as a hairline, stars, icons and one accent phrase per screen.",
      "Libre Caslon Display headlines, Manrope body and tracked-caps labels.",
      "Square corners everywhere except round icon controls and calendar days.",
      "No shadows, no decorative gradients."
    ],
    "rules": [
      {
        "name": "The Photos-Carry-Colour Rule",
        "body": "No section adds a saturated colour. If something needs to stand out, it gets a photograph, scale or ink, never a new hue.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "At most one champagne accent phrase per screen. Every other heading stays ink.",
        "section": "colors"
      },
      {
        "name": "The Lining Numerals Rule",
        "body": "Serif numerals use lining figures (5,0 / 130), and times and dates use tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Thirteen Floor Rule",
        "body": "No text on a phone is smaller than 13px.",
        "section": "typography"
      },
      {
        "name": "The No-Shadow Rule",
        "body": "Nothing casts a shadow. Separation comes from a lighter or darker panel, or a 1px hairline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** let a real photograph of Leonardo's work lead every image slot, cropped with an explicit focus point.",
      "**Do** draw the champagne risca under a section title instead of adding a label above it.",
      "**Do** keep buttons and photo frames square-cornered and borders at 1px.",
      "**Do** use the ink band for at most one feature section per page.",
      "**Do** respect reduced motion: content is visible without JavaScript and reveals are static."
    ],
    "donts": [
      "**Don't** add drop shadows, glows or decorative gradients.",
      "**Don't** introduce a new saturated colour; the photographs carry colour.",
      "**Don't** set a champagne accent word in more than one heading per screen.",
      "**Don't** use Cormorant Garamond or any face whose Portuguese accents (é, ê, ú) sit off their letters.",
      "**Don't** show placeholder or generic stock imagery as if it were Leonardo's work."
    ]
  }
