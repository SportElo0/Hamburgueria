# ── MERCANTIL · configuração de ambiente ─────────────────────────────
# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.
# NUNCA publique chaves reais no repositório nem no frontend.

# URL pública do site (metadados, sitemap, verificação de origem)
NEXT_PUBLIC_SITE_URL=https://mercantil.example

# ── Painel administrativo ───────────────────────────────────────────
# Senha do painel /admin e segredo para assinar a sessão (mín. 32 caracteres aleatórios).
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Armazenamento ───────────────────────────────────────────────────
# fs   → arquivos locais em ./.data (desenvolvimento ou servidor Node com disco persistente)
# blob → Vercel Blob (obrigatório em hospedagem serverless sem disco persistente)
STORAGE_DRIVER=fs
BLOB_READ_WRITE_TOKEN=

# ── MERCANTIL VISION (IA) ───────────────────────────────────────────
# Chave da API da OpenAI com créditos de API (uma assinatura do ChatGPT NÃO inclui créditos de API).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Fidelidade à imagem de entrada (high preserva melhor o veículo; custa mais)
OPENAI_INPUT_FIDELITY=high
# Liga/desliga a geração sem remover a chave
VISION_ENABLED=true
# Limites de uso e gasto
VISION_MAX_UPLOAD_MB=8
VISION_PER_IP_DAILY=3
VISION_DAILY_BUDGET=60
# Retenção (dias) de fotos e simulações enviadas com consentimento junto de uma solicitação
VISION_RETENTION_DAYS=90

# Segredo para a rotina de limpeza agendada (/api/cron/purge)
CRON_SECRET=
